{
  "extends": "../../tsconfig.json",
  "include": ["app/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  }
}

[Unit]
Description=M+ Keybot

[Service]
Type=notify
EnvironmentFile=-/etc/mplus-keybot.env
ExecStart=/srv/mplus-keybot/mplus-keybot
WorkingDirectory=/srv/mplus-keybot

# ensure the service restarts after crashing
Restart=always
# amount of time to wait before restarting the service                  
RestartSec=5

[Install]
WantedBy=multi-user.target
